@model IEnumerable<SleepPvtTracker.Web.Models.SleepRecordListViewModel>
@{
    ViewData["Title"] = "睡眠記録一覧";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>睡眠記録一覧</h2>
        <a asp-action="Create" class="btn btn-primary">新しい記録をつける</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>対象日</th>
                    <th>就寝</th>
                    <th>起床</th>
                    <th>睡眠時間</th>
                    <th>眠気レベル</th>
                    <th>備考</th>
                    <th>PVT</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.TargetDate</td>
                        <td>@item.Bedtime</td>
                        <td>@item.WakeUpTime</td>
                        <td>@item.Duration</td>
                        <td>
                            <span class="badge bg-info text-dark">@item.SleepinessLevel</span>
                        </td>
                        <td><small>@item.Comments</small></td>
                        <td>
                            @if (item.HasPvt)
                            {
                                <span class="badge bg-success">実施済 (Score: @item.PvtScore 点)</span>
                            }
                            else if (item.IsPvtAvailable)
                            {
                                <a asp-action="PvtTest" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-primary">テストを行う</a>
                            }
                            else
                            {
                                <span class="text-muted small">(起床後90分経過のため実施不可)</span>
                            }
                        </td>
                        <td>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post"
                                  onsubmit="return confirm('本当に削除しますか？');">
                                <button type="submit" class="btn btn-danger btn-sm">削除</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>